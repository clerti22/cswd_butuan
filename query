CREATE TABLE IF NOT EXISTS pwud_table (
    key_id INT AUTO_INCREMENT PRIMARY KEY,
    first_name VARCHAR(100) NOT NULL,
    middle_name VARCHAR(100) NULL,
    last_name VARCHAR(100) NOT NULL,
    suffix VARCHAR(50) NULL,
    date_of_birth DATE NOT NULL,
    place_of_birth VARCHAR(255) NOT NULL,
    age INT NOT NULL,
    address VARCHAR(255) NOT NULL,
    religion VARCHAR(100) NOT NULL,
    sex ENUM('Male', 'Female') NOT NULL,
    educational_attainment VARCHAR(255) NOT NULL,
    occupation VARCHAR(255) NOT NULL,
    monthly_income DECIMAL(12,2) NOT NULL,
    civil_status ENUM('Single', 'Married', 'Separated', 'Widowed') NOT NULL,
    contact_number VARCHAR(30) NOT NULL,
    services_needed TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS pwud_household_table (
    household_id INT AUTO_INCREMENT PRIMARY KEY,
    pwud_key_id INT NOT NULL,
    member_name VARCHAR(150) NOT NULL,
    member_age INT NOT NULL,
    member_gender ENUM('Male', 'Female') NOT NULL,
    relationship_to_pwud VARCHAR(150) NOT NULL,
    member_occupation VARCHAR(255) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_pwud_household_person
        FOREIGN KEY (pwud_key_id) REFERENCES pwud_table(key_id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

CREATE TABLE IF NOT EXISTS soloparent_info_table (
    id INT AUTO_INCREMENT PRIMARY KEY,
    first_name VARCHAR(100) NOT NULL,
    middle_name VARCHAR(100) NULL,
    last_name VARCHAR(100) NOT NULL,
    suffix VARCHAR(50) NULL,
    date_of_birth DATE NOT NULL,
    place_of_birth VARCHAR(255) NOT NULL,
    age INT NOT NULL,
    address VARCHAR(255) NOT NULL,
    religion VARCHAR(100) NOT NULL,
    sex VARCHAR(50) NOT NULL,
    educational_attainment VARCHAR(255) NOT NULL,
    occupation VARCHAR(255) NOT NULL,
    company_agency VARCHAR(255) NOT NULL,
    civil_status VARCHAR(50) NOT NULL,
    employment_status VARCHAR(50) NOT NULL,
    contact_number VARCHAR(30) NOT NULL,
    monthly_income DECIMAL(12,2) NOT NULL,
    philsys_card_number VARCHAR(100) NOT NULL,
    email_address VARCHAR(150) NULL,
    pantawid_beneficiary ENUM('yes', 'no') NOT NULL,
    pantawid_household_id VARCHAR(100) NULL,
    indigenous_person ENUM('yes', 'no') NOT NULL,
    indigenous_affiliation_name VARCHAR(255) NULL,
    lgbtq_plus ENUM('yes', 'no') NOT NULL,
    pwd_status ENUM('yes', 'no') NOT NULL,
    solo_classification TEXT NOT NULL,
    solo_needs TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS household_members_soloparent (
    id INT AUTO_INCREMENT PRIMARY KEY,
    solo_parent_id INT NOT NULL,
    household_name VARCHAR(150) NOT NULL,
    household_sex VARCHAR(20) NOT NULL,
    household_relationship VARCHAR(120) NOT NULL,
    household_age INT NOT NULL,
    household_birthdate DATE NOT NULL,
    household_civil_status VARCHAR(50) NOT NULL,
    household_educational VARCHAR(255) NOT NULL,
    household_occupation VARCHAR(255) NOT NULL,
    household_monthly_income DECIMAL(12,2) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_household_members_soloparent
        FOREIGN KEY (solo_parent_id) REFERENCES soloparent_info_table(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

CREATE TABLE IF NOT EXISTS pyap_table (
    id INT AUTO_INCREMENT PRIMARY KEY,
    first_name VARCHAR(100) NOT NULL,
    middle_name VARCHAR(100) NULL,
    last_name VARCHAR(100) NOT NULL,
    suffix VARCHAR(50) NULL,
    date_of_birth DATE NOT NULL,
    place_of_birth VARCHAR(255) NOT NULL,
    nationality VARCHAR(100) NOT NULL,
    age INT NOT NULL,
    address VARCHAR(255) NOT NULL,
    religion VARCHAR(100) NOT NULL,
    sex VARCHAR(20) NOT NULL,
    in_school_youth VARCHAR(150) NOT NULL,
    out_of_school_youth VARCHAR(150) NOT NULL,
    other_disadvantage_youth VARCHAR(150) NOT NULL,
    ips VARCHAR(150) NULL,
    occupation VARCHAR(255) NOT NULL,
    civil_status VARCHAR(80) NOT NULL,
    contact_number VARCHAR(30) NOT NULL,
    school_last_attended VARCHAR(255) NOT NULL,
    school_last_attended_month_year VARCHAR(20) NOT NULL,
    trainings_attended TEXT NOT NULL,
    skills_interest_hobbies TEXT NOT NULL,
    assistance_received TEXT NOT NULL,
    assistance_specify TEXT NOT NULL,
    intervention_needed TEXT NOT NULL,
    intervention_specify TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS pyap_family_composition_table (
    id INT AUTO_INCREMENT PRIMARY KEY,
    pyap_id INT NOT NULL,
    member_name VARCHAR(150) NOT NULL,
    relationship VARCHAR(150) NOT NULL,
    gender VARCHAR(50) NOT NULL,
    age INT NOT NULL,
    grade_year VARCHAR(100) NOT NULL,
    isy VARCHAR(100) NOT NULL,
    osy VARCHAR(100) NOT NULL,
    work_labor_experience VARCHAR(255) NOT NULL,
    income VARCHAR(120) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_pyap_family_person
        FOREIGN KEY (pyap_id) REFERENCES pyap_table(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

CREATE TABLE IF NOT EXISTS pyap_membership_table (
    id INT AUTO_INCREMENT PRIMARY KEY,
    pyap_id INT NOT NULL,
    organization_name VARCHAR(255) NOT NULL,
    position_held VARCHAR(255) NOT NULL,
    year VARCHAR(20) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_pyap_membership_person
        FOREIGN KEY (pyap_id) REFERENCES pyap_table(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);
